# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit it.
#
# Vite requires the VITE_ prefix to expose a variable to the browser.
# ANYTHING with the VITE_ prefix ends up in the public JS bundle.
# => Only the anon key goes here. The service_role key NEVER does;
#    it lives exclusively in Supabase Edge Function secrets.
# ─────────────────────────────────────────────────────────────

# Supabase → Settings → Data API → Project URL
VITE_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co

# Supabase → Settings → API Keys → anon / public
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJI...

# Edge Function endpoints (derived from the project URL)
VITE_WA_SEND_URL=https://xxxxxxxxxxxxx.supabase.co/functions/v1/wa-send

# Retrieval hand-over window in minutes. Must match the pg_cron job in
# supabase/migrations — see MIGRATION note there before changing.
VITE_PICKUP_TIMEOUT_MINUTES=10

# ── WEB PUSH (notifications that reach a CLOSED app) ──────────────────
#
# The PUBLIC half of the VAPID keypair. Safe to ship in the bundle — the
# browser needs it to create a subscription only this project's private key
# can send to.
#
# MUST match the pair set on the push-send Edge Function, or every send is
# rejected with 403 VapidPkHashMismatch. Generate a pair with:
#   node scripts/generate-vapid.mjs
#
# Leave it unset and push is simply off: the in-app alerts still work while
# the app is open, and pushStatus() reports 'not_configured'.
VITE_VAPID_PUBLIC_KEY=
